{
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/analyze.js": {
      "includeFiles": "criteria-guide.html"
    },
    "api/bannerCopy.js": {
      "includeFiles": "criteria-guide.html"
    },
    "api/bannerImage.js": {
      "includeFiles": "criteria-guide.html"
    }
  }
}
